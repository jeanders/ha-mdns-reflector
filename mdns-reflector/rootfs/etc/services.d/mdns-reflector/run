#!/usr/bin/with-contenv bashio
# ==============================================================================
# Generate an Avahi configuration from the add-on options and start the daemon.
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
declare -a interfaces=()
declare -a filters=()
declare avahi_conf="/etc/avahi/avahi-daemon.conf"
declare -a args=()
declare addr
declare filter_line=""
declare log_level

# bashio::config emits one line per element for list options.
while read -r line; do
    if bashio::var.has_value "${line}"; then
        interfaces+=("${line}")
    fi
done <<< "$(bashio::config 'interfaces')"

while read -r line; do
    if bashio::var.has_value "${line}"; then
        filters+=("${line}")
    fi
done <<< "$(bashio::config 'reflect_filters')"

# ------------------------------------------------------------------ validate --
if [[ "${#interfaces[@]}" -lt 2 ]]; then
    bashio::log.fatal "Need at least two interfaces to reflect between."
    bashio::exit.nok "Configured interfaces: ${#interfaces[@]}"
fi

declare -a missing=()
for iface in "${interfaces[@]}"; do
    if ip -o link show "${iface}" &>/dev/null; then
        addr=$(ip -4 -o addr show "${iface}" 2>/dev/null | awk '{print $4}' | paste -sd, -)
        if bashio::var.has_value "${addr}"; then
            bashio::log.info "Interface ${iface}: present (${addr})"
        else
            bashio::log.warning "Interface ${iface}: present, but has no IPv4 address."
            bashio::log.warning "Avahi ignores interfaces without an address."
        fi
    else
        missing+=("${iface}")
        bashio::log.error "Interface ${iface}: not found on the host."
    fi
done

if [[ "${#missing[@]}" -gt 0 ]]; then
    bashio::log.error "Create the VLAN sub-interfaces on the host first, e.g.:"
    bashio::log.error "  ha network vlan end0 20 --ipv4-method static \\"
    bashio::log.error "     --ipv4-address 192.168.20.5/24"
    bashio::exit.nok "Missing interfaces: ${missing[*]}"
fi

# --------------------------------------------------------------------- build --
if [[ "${#filters[@]}" -gt 0 ]]; then
    filter_line="reflect-filters=$(IFS=,; echo "${filters[*]}")"
    bashio::log.info "Reflecting only: ${filters[*]}"
else
    bashio::log.info "Reflecting all service types between ${interfaces[*]}"
    bashio::log.info "The host's own announcements are never reflected, so Home"
    bashio::log.info "Assistant and Scrypted services are excluded automatically."
fi

rm -f "${avahi_conf}"
{
    echo "# Generated by the mDNS Reflector add-on - edits here are overwritten."
    echo "[server]"
    echo "use-ipv4=yes"
    echo "use-ipv6=$(bashio::config.true 'reflect_ipv6' && echo yes || echo no)"
    echo "allow-interfaces=$(IFS=,; echo "${interfaces[*]}")"
    echo "# No D-Bus in this container; the daemon runs standalone."
    echo "enable-dbus=no"
    echo "# 'no' lets Avahi share :5353 with Home Assistant's own zeroconf stack."
    echo "disallow-other-stacks=$(bashio::config.true 'disallow_other_stacks' && echo yes || echo no)"
    echo "allow-point-to-point=$(bashio::config.true 'allow_point_to_point' && echo yes || echo no)"
    echo ""
    echo "[wide-area]"
    echo "enable-wide-area=no"
    echo ""
    echo "[publish]"
    echo "# This add-on relays other hosts' records only. Publishing would"
    echo "# announce this host on every VLAN and collide with Home Assistant."
    echo "disable-publishing=yes"
    echo "disable-user-service-publishing=yes"
    echo "publish-addresses=no"
    echo "publish-hinfo=no"
    echo "publish-workstation=no"
    echo ""
    echo "[reflector]"
    echo "enable-reflector=yes"
    echo "reflect-ipv=$(bashio::config.true 'reflect_between_ipv4_ipv6' && echo yes || echo no)"
    if bashio::var.has_value "${filter_line}"; then
        echo "${filter_line}"
    fi
} > "${avahi_conf}"

log_level=$(bashio::config 'log_level' 'info')

if [[ "${log_level}" == "debug" ]]; then
    bashio::log.debug "--- generated avahi-daemon.conf ---"
    while read -r line; do
        bashio::log.debug "${line}"
    done < "${avahi_conf}"
fi

# ----------------------------------------------------------------------- run --
# --no-chroot:    the Debian package chroots by default, which fails in a container
# --no-drop-root: avoids uid problems on the add-on's writable paths
args=(--no-chroot --no-drop-root -f "${avahi_conf}")

if [[ "${log_level}" == "debug" ]]; then
    args+=(--debug)
fi

bashio::log.info "Starting Avahi reflector across: ${interfaces[*]}"
exec avahi-daemon "${args[@]}"
