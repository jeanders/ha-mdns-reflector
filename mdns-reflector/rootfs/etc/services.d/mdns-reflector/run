#!/usr/bin/with-contenv bashio
# ==============================================================================
# Generate an Avahi configuration from the add-on options and start the daemon.
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
declare -a interfaces=()
declare -a filters=()
declare avahi_conf="/etc/avahi/avahi-daemon.conf"
declare -a args=()
declare addr
declare filter_line=""
declare log_level

# bashio::config emits one line per element for list options.
while read -r line; do
    if bashio::var.has_value "${line}"; then
        interfaces+=("${line}")
    fi
done <<< "$(bashio::config 'interfaces')"

while read -r line; do
    if bashio::var.has_value "${line}"; then
        filters+=("${line}")
    fi
done <<< "$(bashio::config 'reflect_filters')"

declare -a exclude_sources=()
while read -r line; do
    if bashio::var.has_value "${line}"; then
        exclude_sources+=("${line}")
    fi
done <<< "$(bashio::config 'exclude_sources')"

declare -a exclude_names=()
while read -r line; do
    if bashio::var.has_value "${line}"; then
        exclude_names+=("${line}")
    fi
done <<< "$(bashio::config 'exclude_names')"

# ------------------------------------------------------------------ validate --
if [[ "${#interfaces[@]}" -lt 2 ]]; then
    bashio::log.fatal "Need at least two interfaces to reflect between."
    bashio::exit.nok "Configured interfaces: ${#interfaces[@]}"
fi

declare -a missing=()
for iface in "${interfaces[@]}"; do
    if ip -o link show "${iface}" &>/dev/null; then
        addr=$(ip -4 -o addr show "${iface}" 2>/dev/null | awk '{print $4}' | paste -sd, -)
        if bashio::var.has_value "${addr}"; then
            bashio::log.info "Interface ${iface}: present (${addr})"
        else
            bashio::log.warning "Interface ${iface}: present, but has no IPv4 address."
            bashio::log.warning "Avahi ignores interfaces without an address."
        fi
    else
        missing+=("${iface}")
        bashio::log.error "Interface ${iface}: not found on the host."
    fi
done

if [[ "${#missing[@]}" -gt 0 ]]; then
    bashio::log.error "Create the VLAN sub-interfaces on the host first, e.g.:"
    bashio::log.error "  ha network vlan end0 20 --ipv4-method static \\"
    bashio::log.error "     --ipv4-address 192.168.20.5/24"
    bashio::exit.nok "Missing interfaces: ${missing[*]}"
fi

# ---------------------------------------------------------- source excludes --
# A host sitting on two reflected VLANs at once (docked laptop: wired on one,
# Wi-Fi on the other) receives its own reflected announcements and treats them
# as a name conflict, renaming itself forever. Avahi cannot filter this: A
# records bypass reflect-filters entirely, and the packets are not local to
# this host, so originates_from_local_iface does not apply. Dropping that
# host's mDNS before Avahi sees it is the only lever available here.
#
# Rules live in a dedicated chain that is rebuilt from scratch on every start,
# so removing an address from the option really removes its rule.
readonly EXCLUDE_CHAIN="MDNS_REFLECTOR"

if command -v iptables &>/dev/null; then
    # Detach and drop any chain left behind by a previous run.
    while iptables -C INPUT -p udp --dport 5353 -j "${EXCLUDE_CHAIN}" &>/dev/null; do
        iptables -D INPUT -p udp --dport 5353 -j "${EXCLUDE_CHAIN}"
    done
    iptables -F "${EXCLUDE_CHAIN}" &>/dev/null || true
    iptables -X "${EXCLUDE_CHAIN}" &>/dev/null || true

    if [[ "${#exclude_sources[@]}" -gt 0 || "${#exclude_names[@]}" -gt 0 ]]; then
        exclude_mode=$(bashio::config 'exclude_mode' 'advertisements')

        if iptables -N "${EXCLUDE_CHAIN}" &>/dev/null; then
            for src in "${exclude_sources[@]}"; do
                added=""

                if [[ "${exclude_mode}" == "advertisements" ]]; then
                    # Match only mDNS responses: in the DNS header the QR bit is
                    # the top bit of the flags. u32 walks past the IP header
                    # (0>>22&0x3C) and the 8-byte UDP header, then tests it.
                    if iptables -A "${EXCLUDE_CHAIN}" -s "${src}" \
                        -m u32 --u32 "0>>22&0x3C@8&0x8000=0x8000" \
                        -j DROP &>/dev/null
                    then
                        added="responses only"
                    else
                        bashio::log.warning "Kernel has no u32 match; falling back to dropping all mDNS from ${src}."
                    fi
                fi

                if bashio::var.is_empty "${added}"; then
                    if iptables -A "${EXCLUDE_CHAIN}" -s "${src}" -j DROP &>/dev/null; then
                        added="all mDNS"
                    fi
                fi

                if bashio::var.has_value "${added}"; then
                    bashio::log.info "Excluding ${added} from ${src}"
                else
                    bashio::log.error "Could not add exclusion for '${src}' - is it a valid address?"
                fi
            done

            # Name-based exclusions. mDNS labels travel as plain ASCII, so a
            # fixed-string match on the packet finds a host by its own name
            # even as DHCP moves it between addresses.
            for pattern in "${exclude_names[@]}"; do
                declare -a name_rule=(-m string --algo bm --string "${pattern}")

                if [[ "${exclude_mode}" == "advertisements" ]]; then
                    if iptables -A "${EXCLUDE_CHAIN}" \
                        -m u32 --u32 "0>>22&0x3C@8&0x8000=0x8000" \
                        "${name_rule[@]}" -j DROP &>/dev/null
                    then
                        bashio::log.info "Excluding responses naming '${pattern}'"
                        continue
                    fi
                fi

                if iptables -A "${EXCLUDE_CHAIN}" "${name_rule[@]}" -j DROP &>/dev/null; then
                    bashio::log.info "Excluding all mDNS naming '${pattern}'"
                else
                    bashio::log.error "Kernel has no string match; exclude_names is NOT active for '${pattern}'."
                fi
            done

            iptables -I INPUT -p udp --dport 5353 -j "${EXCLUDE_CHAIN}"

            if [[ "${exclude_mode}" == "all" ]]; then
                bashio::log.notice "Excluded hosts are hidden from Home Assistant's own discovery, and"
                bashio::log.notice "cannot discover anything across VLANs themselves."
            fi
        else
            bashio::log.error "Could not create the ${EXCLUDE_CHAIN} chain; exclusions are NOT active."
        fi
    fi
elif [[ "${#exclude_sources[@]}" -gt 0 ]]; then
    bashio::log.error "exclude_sources is set but iptables is unavailable; exclusions are NOT active."
fi

# --------------------------------------------------------------------- build --
if [[ "${#filters[@]}" -gt 0 ]]; then
    filter_line="reflect-filters=$(IFS=,; echo "${filters[*]}")"

    # Avahi's config parser reads each line into a 128-byte buffer
    # (char ln[128] in avahi-daemon/main.c). A longer line is split, and the
    # tail is parsed as a new line, which fails with a confusing
    # "Missing assignment" error. Catch it here with an explanation instead.
    # Splitting across several reflect-filters= lines does not help: the
    # parser frees and replaces the list for each occurrence.
    if [[ "${#filter_line}" -gt 120 ]]; then
        bashio::log.fatal "reflect_filters is too long: the generated line is ${#filter_line} characters."
        bashio::log.fatal "Avahi's parser reads config lines into a 128-byte buffer, so it must stay under that."
        bashio::log.fatal "Matching is a substring test, so use short stems instead of full service types:"
        bashio::log.fatal "  '_hap.' covers _hap._tcp.local and _hap._udp.local"
        bashio::log.fatal "  '_matter' covers _matter._tcp.local and _matterc._udp.local"
        bashio::log.fatal "  '_ipp' covers _ipp._tcp.local and _ipps._tcp.local"
        bashio::exit.nok "Shorten reflect_filters, or empty it to reflect everything."
    fi

    bashio::log.info "Reflecting only: ${filters[*]}"
else
    bashio::log.info "Reflecting all service types between ${interfaces[*]}"
    bashio::log.info "The host's own announcements are never reflected, so Home"
    bashio::log.info "Assistant and Scrypted services are excluded automatically."
fi

rm -f "${avahi_conf}"
{
    echo "# Generated by the mDNS Reflector add-on - edits here are overwritten."
    echo "[server]"
    echo "use-ipv4=yes"
    echo "use-ipv6=$(bashio::config.true 'reflect_ipv6' && echo yes || echo no)"
    echo "allow-interfaces=$(IFS=,; echo "${interfaces[*]}")"
    echo "# No D-Bus in this container; the daemon runs standalone."
    echo "enable-dbus=no"
    echo "# 'no' lets Avahi share :5353 with Home Assistant's own zeroconf stack."
    echo "disallow-other-stacks=$(bashio::config.true 'disallow_other_stacks' && echo yes || echo no)"
    echo "allow-point-to-point=$(bashio::config.true 'allow_point_to_point' && echo yes || echo no)"
    echo ""
    echo "[wide-area]"
    echo "enable-wide-area=no"
    echo ""
    echo "[publish]"
    echo "# This add-on relays other hosts' records only. Publishing would"
    echo "# announce this host on every VLAN and collide with Home Assistant."
    echo "disable-publishing=yes"
    echo "disable-user-service-publishing=yes"
    echo "publish-addresses=no"
    echo "publish-hinfo=no"
    echo "publish-workstation=no"
    echo ""
    echo "[reflector]"
    echo "enable-reflector=yes"
    echo "reflect-ipv=$(bashio::config.true 'reflect_between_ipv4_ipv6' && echo yes || echo no)"
    if bashio::var.has_value "${filter_line}"; then
        echo "${filter_line}"
    fi
} > "${avahi_conf}"

log_level=$(bashio::config 'log_level' 'info')

if [[ "${log_level}" == "debug" ]]; then
    bashio::log.debug "--- generated avahi-daemon.conf ---"
    while read -r line; do
        bashio::log.debug "${line}"
    done < "${avahi_conf}"
fi

# ----------------------------------------------------------------------- run --
# --no-chroot:    the Debian package chroots by default, which fails in a container
# --no-drop-root: avoids uid problems on the add-on's writable paths
args=(--no-chroot --no-drop-root -f "${avahi_conf}")

if [[ "${log_level}" == "debug" ]]; then
    args+=(--debug)
fi

bashio::log.info "Starting Avahi reflector across: ${interfaces[*]}"
exec avahi-daemon "${args[@]}"
